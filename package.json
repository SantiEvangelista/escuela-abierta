{
  "name": "escuela-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:check": "node scripts/db-check.mjs",
    "db:migrate": "node scripts/data.mjs migrate",
    "data:validate": "node scripts/data.mjs validate",
    "data:import": "node scripts/data.mjs import",
    "data:publish": "node scripts/data.mjs publish",
    "test:api": "node scripts/test-api.mjs",
    "test:locations": "node scripts/test-locations.mjs"
  },
  "dependencies": {
    "@scalar/nextjs-api-reference": "0.12.15",
    "leaflet": "1.9.4",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "read-excel-file": "9.3.14",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
