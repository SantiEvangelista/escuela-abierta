# Solo desarrollo local. No usar estas credenciales en producción.
APP_PORT=3100
POSTGRES_USER=escuela
POSTGRES_PASSWORD=escuela_local_only
POSTGRES_DB=escuela_api
# En Vercel configurar DATABASE_URL con la conexión del proveedor PostgreSQL.
# Compose proporciona DATABASE_URL automáticamente al contenedor app.

# Dominio público HTTPS definitivo. Vacío mantiene noindex en entorno local.
SITE_URL=

# Requerido para participación. Usar un secreto aleatorio de 32 bytes o más.
ATTENDANCE_SECRET=
